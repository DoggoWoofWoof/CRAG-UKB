  "no_gold_in_pool_construction": true,
  "no_dataset_id_feature": true,
  "no_hop_or_benchmark_metadata_feature": true,
  "verification_channel_frozen": true,
  "structural_orderer_frozen_s_dir": true,
  "no_new_retriever_encoder_graph_c11a": true,
  "only_reserve_policy_representation_changed": true
 },
